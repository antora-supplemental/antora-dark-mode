{
  "name": "antora-dark-mode",
  "version": "1.5.0",
  "description": "Compatibility path for antora-dark-mode 1.x. Dark mode moved to antora-ui-chassis (antora-dark-mode 2.x on npm). Warns once per build, then uses the chassis packages.",
  "keywords": [
    "antora",
    "antora-extension",
    "dark-mode",
    "documentation",
    "asciidoc"
  ],
  "homepage": "https://antora-supplemental.github.io/antora-dark-mode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antora-supplemental/antora-dark-mode.git"
  },
  "bugs": {
    "url": "https://github.com/antora-supplemental/antora-dark-mode/issues"
  },
  "license": "MIT",
  "author": "Ryan Johnson (https://github.com/AMDphreak)",
  "main": "lib/index.js",
  "files": [
    "lib/**/*",
    "supplemental-ui/**/*",
    "ui-modules/**/*"
  ],
  "scripts": {
    "build": "antora antora-playbook.yml",
    "build:local": "antora antora-playbook-local.yml",
    "preview": "antora antora-playbook.yml",
    "serve": "pnpm build && npx http-server build/site -p 8080 -o",
    "clean": "rimraf build .cache",
    "ui-modules:sync": "node scripts/sync-ui-module.mjs",
    "ui-modules:validate": "node ui-modules/scripts/validate-ui-modules.mjs",
    "prepack": "pnpm ui-modules:sync && pnpm ui-modules:validate",
    "publish:npm": "node scripts/npm-publish.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@antora-supplemental/default-paint": "github:antora-supplemental/antora-ui-chassis#default-paint-v0.2.0&path:packages/default-paint",
    "@antora-supplemental/light-dark-mode": "github:antora-supplemental/antora-ui-chassis#light-dark-mode-v0.1.0&path:packages/light-dark-mode"
  },
  "devDependencies": {
    "@antora/lunr-extension": "1.0.0-alpha.12",
    "@asciidoctor/tabs": "^1.0.0-beta.6",
    "@biomejs/biome": "^2.5.15",
    "antora": "^3.1.14",
    "http-server": "^14.1.1",
    "json5": "^2.2.3",
    "rimraf": "^6.0.1"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "private": true,
  "antoraRegistry": {
    "requires": {
      "@antora-supplemental/default-paint": "^0.2.0",
      "@antora-supplemental/light-dark-mode": "^0.1.0"
    },
    "worksWith": {
      "antora/antora-ui-default": "*"
    },
    "uses": {
      "default-ui-markup": "2",
      "default-ui-paint-tokens": "^0.2",
      "light-dark-slots": "^0.1"
    }
  }
}
